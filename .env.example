# Website / Prisma
DATABASE_URL=postgresql://zakazavto:password@postgres:5432/zakazavto_db
NEXT_PUBLIC_SITE_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

# Telegram notifications used by the website
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional standalone Python bot/API configuration
BOT_TOKEN=
MANAGER_CHAT_ID=

# API Configuration
API_SECRET=your-strong-api-secret-key-here
API_HOST=0.0.0.0
API_PORT=8000

# Python service database URL, if standalone bot/API is enabled
PYTHON_DATABASE_URL=postgresql+asyncpg://zakazavto:password@postgres:5432/zakazavto_db

# Admin Telegram IDs (comma-separated)
ADMIN_TELEGRAM_IDS=

# Webhook Configuration (optional, for production)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_PATH=/webhook

# Logging
LOG_LEVEL=INFO

# Application Settings
RATE_LIMIT_PER_MINUTE=60
IDEMPOTENCY_CACHE_TTL=86400

# Distribution Algorithm
# Options: round_robin, least_loaded
DISTRIBUTION_ALGORITHM=round_robin
